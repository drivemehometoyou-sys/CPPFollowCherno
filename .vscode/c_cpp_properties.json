{
    "configurations": [
        {
            "name": "Win32",
            "includePath": [
                "${workspaceFolder}/**",
                // GLFW 第三方库头文件搜索路径，供 IntelliSense 查找和解析
                "${workspaceFolder}/Lesson39/Dependencies/GLFW/include",
                "${workspaceFolder}/Lesson41/Engine/src"
            ],
            "defines": [
                "_DEBUG",
                "UNICODE",
                "_UNICODE",
