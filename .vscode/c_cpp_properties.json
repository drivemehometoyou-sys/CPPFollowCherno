                "GLFW_DLL"
            ],
            "compilerPath": "C:\\dev\\w64devkit\\bin\\gcc.exe",
            "cStandard": "gnu23",
            "cppStandard": "gnu++20",
            "intelliSenseMode": "windows-gcc-x64"
        }
    ],
    "version": 4
}